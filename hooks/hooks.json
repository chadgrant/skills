{
  "description": "Logs every subagent (timing, tokens, context, model, provider), every brief dispatched, every skill loaded, every main-session turn of sessions that use this plugin, and every API failure, to the project's delivery journal.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": ".+",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/implementation/scripts/journal.py",
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".+",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/implementation/scripts/journal.py",
              "hook"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/implementation/scripts/journal.py",
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|Skill)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/implementation/scripts/journal.py",
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/implementation/scripts/journal.py",
              "hook"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
